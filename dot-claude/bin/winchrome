#!/usr/bin/env bash
# Bridge WSL -> Chrome on Windows.
#
# Chrome only ever binds --remote-debugging-port to 127.0.0.1, and WSL2's default
# NAT networking gives WSL its own loopback, so the DevTools port is up on Windows
# and unreachable from Linux at the same time. cdp-relay.py (run by the Windows
# python) listens on 0.0.0.0 and forwards to that loopback, which WSL can reach.
# Measured on this machine 2026-08-06: no admin, no firewall prompt, no .wslconfig,
# and no `wsl --shutdown` (which would kill every running session, including the
# one asking for the browser).
#
#   winchrome start [url]   launch Chrome + relay, print the endpoint
#   winchrome status        health-check every hop
#   winchrome stop          stop Chrome and the relay
#   winchrome env           print the exports a driver needs

set -uo pipefail

CHROME_PORT="${CHROME_PORT:-9224}"
RELAY_PORT="${RELAY_PORT:-9324}"
PROFILE='C:\Users\shova\AppData\Local\ClaudeChromeAutomation'
WIN_PY='C:\Users\shova\AppData\Local\Programs\Python\Python311\python.exe'
RELAY='C:\Users\shova\.claude\bin\cdp-relay.py'
CHROME_EXE="/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"
PS="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"

host_ip() { ip route show default | awk '{print $3; exit}'; }
HOST="$(host_ip)"
ENDPOINT="http://${HOST}:${RELAY_PORT}"

alive() { curl -fsS -m 3 "${ENDPOINT}/json/version" >/dev/null 2>&1; }

start_relay() {
  "$PS" -NoProfile -Command \
    "Start-Process -WindowStyle Hidden -FilePath '${WIN_PY}' -ArgumentList '${RELAY}','${RELAY_PORT}','${CHROME_PORT}'" \
    >/dev/null 2>&1
}

start_chrome() {
  # A dedicated profile, not the default one. Chrome cannot turn on debugging for
  # a profile that is already running, and pointing this at the everyday profile
  # would either fail or hijack the window the operator is using. A persistent
  # directory (not a temp dir) is deliberate: cookies survive, so a console login
  # is done once rather than every launch.
  "$CHROME_EXE" \
    --remote-debugging-port="${CHROME_PORT}" \
    --user-data-dir="${PROFILE}" \
    --no-first-run --no-default-browser-check \
    "$@" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

case "${1:-start}" in
  start)
    if alive; then
      echo "already up at ${ENDPOINT}"
    else
      pgrep -f "cdp-relay" >/dev/null 2>&1 || true
      start_chrome "${2:-about:blank}"
      start_relay
      for i in $(seq 1 20); do sleep 1; alive && break; done
      alive || { echo "FAILED: no CDP at ${ENDPOINT} after 20s"; exit 1; }
      echo "up at ${ENDPOINT}"
    fi
    [ -n "${2:-}" ] && curl -fsS -m 5 -X PUT "${ENDPOINT}/json/new?$(printf %s "$2" | sed 's/:/%3A/g;s#/#%2F#g')" >/dev/null 2>&1
    echo "export CDP_HOST=${HOST} CDP_PORT=${RELAY_PORT}"
    ;;
  status)
    printf 'chrome on windows loopback %s: ' "${CHROME_PORT}"
    "$PS" -NoProfile -Command \
      "try{(Invoke-WebRequest -UseBasicParsing -TimeoutSec 3 http://127.0.0.1:${CHROME_PORT}/json/version).StatusCode}catch{'DOWN'}" 2>/dev/null | tr -d '\r'
    printf 'relay listening %s: ' "${RELAY_PORT}"
    # Not `| grep -q`: under `set -o pipefail`, grep -q exits on first match and
    # closes the pipe, netstat/tr die on SIGPIPE, and the pipeline reports failure
    # for a lookup that in fact succeeded. That printed "NO" beside a relay the
    # very next line reached over the network. Collect first, test after.
    _ns="$(/mnt/c/Windows/System32/NETSTAT.EXE -ano 2>/dev/null | tr -d '\r' || true)"
    case "$_ns" in *":${RELAY_PORT} "*) echo YES ;; *) echo NO ;; esac
    printf 'wsl -> %s: ' "${ENDPOINT}"
    alive && echo OK || echo UNREACHABLE
    ;;
  stop)
    "$PS" -NoProfile -Command \
      "Get-CimInstance Win32_Process -Filter \"name='python.exe'\" | Where-Object {\$_.CommandLine -like '*cdp-relay*'} | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" \
      >/dev/null 2>&1
    /mnt/c/Windows/System32/taskkill.exe /F /IM chrome.exe >/dev/null 2>&1
    echo "stopped chrome + relay"
    ;;
  env) echo "export CDP_HOST=${HOST} CDP_PORT=${RELAY_PORT}" ;;
  *) sed -n '2,14p' "$0"; exit 2 ;;
esac
