{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "API_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .git*)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.production)",
      "Edit(.env.staging)",
      "Edit(.env.development)",
      "Edit(.env.test)",
      "Edit(**/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.config/gh/hosts.yml)",
      "Edit(~/.azure/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(**/credentials.json)",
      "Edit(**/credentials.yaml)",
      "Edit(**/credentials.yml)",
      "Edit(**/service-account*.json)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/credentials.json)",
      "Read(**/credentials.yaml)",
      "Read(**/credentials.yml)",
      "Read(**/service-account*.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
              "/c/Users/shova/.claude/hooks/session-recall.sh"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\Users\\shova\\claude-setup\\tools\\bus\\bus.py",
              "inbox"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\Users\\shova\\.claude\\hooks\\safety_gate.py"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\Users\\shova\\.claude\\hooks\\pre_push_gate.py"
            ],
            "timeout": 90
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
              "/c/Users/shova/.claude/hooks/precompact-handoff.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\Users\\shova\\.claude\\hooks\\completion_gate.py"
            ],
            "timeout": 8
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\Users\\shova\\.claude\\hooks\\ship_gate_stop.py"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\shova\\.claude\\hooks\\notify-toast.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Raising Windows toast",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:\\Users\\shova\\claude-setup\\tools\\bus\\bus.py",
              "inbox"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": true,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": false,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
