#!/usr/bin/env bash
set -euo pipefail

BUNX_BIN="${BUNX_BIN:-bunx}"
OUTPUT_DIR="${PLAYWRIGHT_MCP_OUTPUT_DIR:-/tmp/playwright-mcp-visual}"

mkdir -p "$OUTPUT_DIR"

exec "$BUNX_BIN" -y @playwright/mcp@latest \
  --browser chrome \
  --caps vision,devtools \
  --image-responses allow \
  --snapshot-mode full \
  --output-dir "$OUTPUT_DIR" \
  "$@"
