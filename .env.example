# Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to version control.

# --- LLM Providers ---
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Google (Gemini)
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_KEY=

# NVIDIA
NVIDIA_API_KEY=

# Hugging Face
HF_TOKEN=
HUGGINGFACE_API_KEY=

# --- Audio / Transcription ---
# ElevenLabs
ELEVEN_LABS_KEY=
ELEVENLABS_API_KEY=
ELEVEN_API_KEY=

# --- Media ---
# Giphy (for meme hooks)
GIPHY_API_KEY=

# --- Cloud / Infra ---
# AWS (used by gate.py vector fixtures)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Paths ---
# Override paths used by tools. Defaults are relative to repo root.
# INTENT_DB_PATH=
# BUS_JSONL_PATH=
# REVIEWS_DIR=

# --- Telemetry ---
# Disable external telemetry if needed
# TELEMETRY_DISABLED=1
